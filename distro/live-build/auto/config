#!/bin/sh
set -eu

lb config noauto \
  --mode debian \
  --architectures amd64 \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer live \
  --bootappend-live "boot=live components quiet splash username=sl8" \
  --bootappend-live-failsafe "boot=live components memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=normal" \
  --linux-flavours amd64 \
  --iso-application "SL8 Linux" \
  --iso-volume "SL8_ALPHA1" \
  --iso-publisher "IO Technologies" \
  --iso-preparer "SL8 Live Build" \
  --image-name "sl8-alpha1-amd64"
